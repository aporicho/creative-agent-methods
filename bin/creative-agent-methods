#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
COMMAND_NAME="creative-agent-methods"

usage() {
  cat <<'EOF'
creative-agent-methods

Usage:
  creative-agent-methods list
  creative-agent-methods install <codex|claude|opencode|openclaw|all> [options]
  creative-agent-methods install-cli [options]

Install options:
  --dest <dir>       Destination directory for one target.
  --mode <copy|link> Install by copying files or creating symlinks. Default: copy.
  --force            Replace existing installed files for this package.
  --dry-run          Show actions without writing files.

CLI options:
  --dest <dir>       Directory for the command symlink. Default: ~/.local/bin.
  --force            Replace an existing command symlink or file.
  --dry-run          Show actions without writing files.

Default destinations:
  codex      ${CODEX_SKILLS_DIR:-$HOME/.codex/skills}
  claude     ${CLAUDE_SKILLS_DIR:-$HOME/.claude/skills}
  opencode   ${OPENCODE_AGENTS_DIR:-$PWD/.opencode/agents}
  openclaw   ${OPENCLAW_AGENTS_DIR:-$PWD/.openclaw/agents}

Examples:
  ./bin/creative-agent-methods install codex
  ./bin/creative-agent-methods install claude --dest ~/.claude/skills
  creative-agent-methods install opencode --dest /path/to/project/.opencode/agents
  creative-agent-methods install all --mode copy --force
  ./bin/creative-agent-methods install-cli
EOF
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

info() {
  printf '%s\n' "$*"
}

expand_path() {
  local input="$1"
  case "$input" in
    "~") printf '%s\n' "$HOME" ;;
    "~/"*) printf '%s/%s\n' "$HOME" "${input#~/}" ;;
    *) printf '%s\n' "$input" ;;
  esac
}

target_source() {
  case "$1" in
    codex) printf '%s/platforms/codex/skills\n' "$PROJECT_ROOT" ;;
    claude) printf '%s/platforms/claude/skills\n' "$PROJECT_ROOT" ;;
    opencode) printf '%s/platforms/opencode/agents\n' "$PROJECT_ROOT" ;;
    openclaw) printf '%s/platforms/openclaw/agents\n' "$PROJECT_ROOT" ;;
    *) die "unknown target: $1" ;;
  esac
}

target_default_dest() {
  case "$1" in
    codex) printf '%s\n' "${CODEX_SKILLS_DIR:-$HOME/.codex/skills}" ;;
    claude) printf '%s\n' "${CLAUDE_SKILLS_DIR:-$HOME/.claude/skills}" ;;
    opencode) printf '%s\n' "${OPENCODE_AGENTS_DIR:-$PWD/.opencode/agents}" ;;
    openclaw) printf '%s\n' "${OPENCLAW_AGENTS_DIR:-$PWD/.openclaw/agents}" ;;
    *) die "unknown target: $1" ;;
  esac
}

list_targets() {
  cat <<EOF
Targets:
  codex      $(target_source codex)
  claude     $(target_source claude)
  opencode   $(target_source opencode)
  openclaw   $(target_source openclaw)
EOF
}

install_one_target() {
  local target="$1"
  local dest="$2"
  local mode="$3"
  local force="$4"
  local dry_run="$5"
  local source_dir

  source_dir="$(target_source "$target")"
  [[ -d "$source_dir" ]] || die "source directory does not exist: $source_dir"

  dest="$(expand_path "$dest")"

  info "Installing $target"
  info "  from: $source_dir"
  info "  to:   $dest"
  info "  mode: $mode"

  if [[ "$dry_run" == "1" ]]; then
    info "  mkdir -p $dest"
  else
    mkdir -p "$dest"
  fi

  shopt -s nullglob
  local items=("$source_dir"/*)
  shopt -u nullglob
  [[ "${#items[@]}" -gt 0 ]] || die "no package files found in: $source_dir"

  local item base target_path
  for item in "${items[@]}"; do
    base="$(basename "$item")"
    target_path="$dest/$base"

    if [[ -e "$target_path" || -L "$target_path" ]]; then
      if [[ "$force" == "1" ]]; then
        if [[ "$dry_run" == "1" ]]; then
          info "  replace: $target_path"
        else
          rm -rf "$target_path"
        fi
      else
        info "  skip existing: $target_path"
        continue
      fi
    fi

    case "$mode" in
      copy)
        if [[ "$dry_run" == "1" ]]; then
          info "  copy: $item -> $dest/"
        else
          cp -R "$item" "$dest/"
          info "  installed: $base"
        fi
        ;;
      link)
        if [[ "$dry_run" == "1" ]]; then
          info "  link: $target_path -> $item"
        else
          ln -s "$item" "$target_path"
          info "  linked: $base"
        fi
        ;;
      *)
        die "invalid mode: $mode"
        ;;
    esac
  done
}

parse_install_options() {
  INSTALL_DEST=""
  INSTALL_MODE="copy"
  INSTALL_FORCE="0"
  INSTALL_DRY_RUN="0"

  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --dest)
        [[ "$#" -ge 2 ]] || die "--dest requires a directory"
        INSTALL_DEST="$2"
        shift 2
        ;;
      --mode)
        [[ "$#" -ge 2 ]] || die "--mode requires copy or link"
        INSTALL_MODE="$2"
        [[ "$INSTALL_MODE" == "copy" || "$INSTALL_MODE" == "link" ]] || die "--mode must be copy or link"
        shift 2
        ;;
      --force)
        INSTALL_FORCE="1"
        shift
        ;;
      --dry-run)
        INSTALL_DRY_RUN="1"
        shift
        ;;
      *)
        die "unknown install option: $1"
        ;;
    esac
  done
}

install_command() {
  [[ "$#" -ge 1 ]] || die "install requires a target"

  local target="$1"
  shift
  parse_install_options "$@"

  if [[ "$target" == "all" ]]; then
    [[ -z "$INSTALL_DEST" ]] || die "--dest can only be used with one target"
    local each
    for each in codex claude opencode openclaw; do
      install_one_target "$each" "$(target_default_dest "$each")" "$INSTALL_MODE" "$INSTALL_FORCE" "$INSTALL_DRY_RUN"
    done
    return
  fi

  case "$target" in
    codex|claude|opencode|openclaw) ;;
    *) die "unknown target: $target" ;;
  esac

  local dest="$INSTALL_DEST"
  if [[ -z "$dest" ]]; then
    dest="$(target_default_dest "$target")"
  fi

  install_one_target "$target" "$dest" "$INSTALL_MODE" "$INSTALL_FORCE" "$INSTALL_DRY_RUN"
}

install_cli_command() {
  local dest="${HOME}/.local/bin"
  local force="0"
  local dry_run="0"

  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --dest)
        [[ "$#" -ge 2 ]] || die "--dest requires a directory"
        dest="$2"
        shift 2
        ;;
      --force)
        force="1"
        shift
        ;;
      --dry-run)
        dry_run="1"
        shift
        ;;
      *)
        die "unknown install-cli option: $1"
        ;;
    esac
  done

  dest="$(expand_path "$dest")"
  local link_path="$dest/$COMMAND_NAME"

  info "Installing CLI"
  info "  command: $link_path"
  info "  source:  $SCRIPT_DIR/$COMMAND_NAME"

  if [[ "$dry_run" == "1" ]]; then
    info "  mkdir -p $dest"
  else
    mkdir -p "$dest"
  fi

  if [[ -e "$link_path" || -L "$link_path" ]]; then
    if [[ "$force" == "1" ]]; then
      if [[ "$dry_run" == "1" ]]; then
        info "  replace: $link_path"
      else
        rm -rf "$link_path"
      fi
    else
      die "command already exists: $link_path (use --force to replace)"
    fi
  fi

  if [[ "$dry_run" == "1" ]]; then
    info "  link: $link_path -> $SCRIPT_DIR/$COMMAND_NAME"
  else
    ln -s "$SCRIPT_DIR/$COMMAND_NAME" "$link_path"
    info "Installed. Ensure $dest is in PATH."
  fi
}

main() {
  local command="${1:-help}"
  if [[ "$#" -gt 0 ]]; then
    shift
  fi

  case "$command" in
    help|-h|--help)
      usage
      ;;
    list)
      list_targets
      ;;
    install)
      install_command "$@"
      ;;
    install-cli)
      install_cli_command "$@"
      ;;
    *)
      die "unknown command: $command"
      ;;
  esac
}

main "$@"
